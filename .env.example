# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit real keys.

# ---------- Stage 1: signaling + WebRTC ----------
# Port the Socket.IO signaling server listens on.
SIGNAL_PORT=4000
# Comma-separated list of web origins allowed to connect (CORS).
# Leave empty during local development to allow any origin (LAN testing).
CORS_ORIGINS=

# TURN relay (Metered Open Relay, free account: https://www.metered.ca/stun-turn).
# Option A (recommended): let the server fetch fresh credentials from Metered.
#   METERED_APP_NAME is the subdomain of your dashboard: <name>.metered.live
METERED_APP_NAME=
METERED_API_KEY=
# Option B: paste static credentials from the Metered dashboard.
#   TURN_URLS is comma-separated, e.g. turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Web app (apps/web) — optional. By default the browser connects to
# <same host as the page>:SIGNAL_PORT, which works for localhost and LAN IPs.
# Put this one in apps/web/.env.local (Next.js reads env files from its own folder):
# NEXT_PUBLIC_SIGNAL_URL=http://localhost:4000

# ---------- Stage 2: AI service (apps/ai, speech-to-text) ----------
# Free key from https://console.groq.com -> API Keys (no credit card).
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Groq free-tier limits for speech-to-text. The AI service never goes above
# these; extra segments go to the local model instead.
GROQ_STT_RPM=20
GROQ_STT_RPD=2000
GROQ_STT_AUDIO_SECONDS_PER_HOUR=7200
GROQ_STT_AUDIO_SECONDS_PER_DAY=28800

# Local fallback (faster-whisper). Sizes: tiny, base, small, medium.
# Bigger = more accurate but slower on CPU. "small" is ~500 MB, downloaded on first run.
LOCAL_WHISPER_MODEL=small
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8
LOCAL_WHISPER_PRELOAD=true

# ---------- Stage 3: translation (NLLB-200 via CTranslate2) ----------
# Created by: npm run setup:models. Leave empty for the default location
# (apps/ai/models/nllb-200-distilled-600M-ct2-int8).
NLLB_MODEL_DIR=
NLLB_DEVICE=cpu
NLLB_COMPUTE_TYPE=int8
# 1 = fastest, 2 = slightly better wording (default), 4 = best but slower.
NLLB_BEAM_SIZE=2
NLLB_PRELOAD=true

# Where the signal server finds the AI service, and a shared secret between
# them (optional locally, set a long random value in production).
AI_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TOKEN=

# ---------- Stage 5: database, accounts, summaries ----------
# Postgres in Docker (npm run db:up). The server creates its tables itself.
POSTGRES_USER=usap
POSTGRES_PASSWORD=usap-dev-password
POSTGRES_DB=usap
DATABASE_URL=postgres://usap:usap-dev-password@127.0.0.1:5432/usap
# No Docker? Comment out DATABASE_URL: the server then uses PGlite (Postgres in
# WebAssembly) stored in apps/signal/.data/, with no install.

# After-call summaries (Groq free-tier LLM). Groq retires models over time;
# list current ones: curl -H "Authorization: Bearer $GROQ_API_KEY" https://api.groq.com/openai/v1/models
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_LLM_RPM=30
GROQ_LLM_RPD=1000
GROQ_LLM_TPM=8000

# Production only: set to true behind a reverse proxy (real client IPs for rate limits).
TRUST_PROXY=false
